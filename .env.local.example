# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials)
YOUTUBE_API_KEY=

# Supabase project (ouuokhwfsfphqzalovvu)
SUPABASE_URL=https://ouuokhwfsfphqzalovvu.supabase.co
# service_role key: Supabase Dashboard > Project Settings > API > service_role (SECRET, server-only)
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret guarding the cron + admin endpoints. Generate any long random string.
# Vercel Cron automatically sends this as a Bearer token when set as an env var named CRON_SECRET.
CRON_SECRET=

# Anthropic API key for the AI content-type classifier (console.anthropic.com > API Keys).
# Classifies "teaching/testimony ABOUT praying for kids" (keep) vs. recited prayers / worship /
# AI "God message" videos (skip). Model is chosen in the app's Settings page.
ANTHROPIC_API_KEY=
